{
  "General": {
    "Environment": "QA",
    "ApplicationName": "Legacy Applications Monitoring",
    "LogDirectory": "C:\\ProgramData\\LegacyServiceMonitor\\Logs",
    "StateFile": "C:\\ProgramData\\LegacyServiceMonitor\\state.json",
    "LogRetentionDays": 7,
    "FailureToleranceMinutes": 30,
    "SendRecoveryNotification": true
  },
  "WebApplications": [
    {
      "ApplicationName": "Legacy Portal",
      "BeatId": "BEAT-1234",
      "Squad": "Payments",
      "Vendor": "TCS",
      "SiteName": "Default Web Site",
      "PoolName": "DefaultAppPool",
      "Enabled": true
    }
  ],
  "WindowsServices": [
    {
      "ApplicationName": "World Wide Web Publishing Service",
      "BeatId": "BEAT-1234",
      "Squad": "Payments",
      "Vendor": "TCS",
      "ServiceName": "W3SVC",
      "Enabled": true
    }
  ],
  "Notification": {
    "From": "monitoring@company.com",
    "To": [
      "support-team@company.com"
    ],
    "Cc": [],
    "SubjectPrefix": "[Legacy Monitor]",
    "Smtp": {
      "Server": "smtp.company.com",
      "Port": 587,
      "UseSsl": true,
      "UseDefaultCredentials": false,
      "CredentialFile": "C:\\ProgramData\\LegacyServiceMonitor\\smtp-credential.xml"
    },
    "Graph": {
      "TenantIdEnvironmentVariable": "GRAPH_TENANT_ID",
      "ClientIdEnvironmentVariable": "GRAPH_CLIENT_ID",
      "ClientSecretEnvironmentVariable": "GRAPH_CLIENT_SECRET",
      "SenderMailbox": "monitoring@company.com"
    }
  }
}
